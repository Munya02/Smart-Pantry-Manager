<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">


    <!-- ===================================== -->
    <!-- TITLE                                 -->
    <!-- ===================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/suggested_recipes"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />


    <!-- ===================================== -->
    <!-- DESCRIPTION                           -->
    <!-- ===================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_description"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />


    <!-- ===================================== -->
    <!-- SCROLLABLE RECIPE AREA                -->
    <!-- ===================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ================================= -->
            <!-- NO MATCH MESSAGE                  -->
            <!-- ================================= -->

            <TextView
                android:id="@+id/txtNoRecipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_matching_recipes"
                android:textSize="17sp"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone"
                android:layout_marginBottom="15dp" />


            <!-- ================================= -->
            <!-- RECIPE BUTTONS APPEAR HERE        -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/recipeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />


        </LinearLayout>

    </ScrollView>


    <!-- ===================================== -->
    <!-- BACK BUTTON                           -->
    <!-- ===================================== -->

    <Button
        android:id="@+id/btnRecipeBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back"
        android:layout_marginTop="10dp" />


</LinearLayout>